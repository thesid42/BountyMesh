# All app sessions use the online integrations. Offline demos are disabled.
BOUNTYMESH_MODE=live

# Required for all app sessions.
# Use a random private value of at least 32 characters.
OPERATOR_TOKEN=

# Supabase: apply supabase/schema.sql before starting the app.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Models can be changed to model IDs available in your provider accounts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Stripe TEST mode only. A Connect test account is required for worker transfers.
STRIPE_SECRET_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=
STRIPE_PAYMENT_METHOD_ID=pm_card_visa

# 32 random bytes encoded as 64 hex characters. Encrypts external agent credentials.
AGENT_SECRET_KEY=
# Required for signed Stripe account.updated webhooks (owner payout readiness).
STRIPE_WEBHOOK_SECRET=
